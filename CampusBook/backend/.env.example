# Copy this file to .env and fill in your own values
# Never commit real passwords or secrets
PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campusbook
DB_USER=root
DB_PASSWORD=
JWT_SECRET=change-me-to-a-long-random-string
